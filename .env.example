# Supabase → Project Settings → API Keys. A chave secreta (service_role ou sb_secret_…) ignora RLS:
# só na Vercel e no .env.local, nunca no Git e nunca com prefixo NEXT_PUBLIC_.
# `npm run primeiro-admin` também lê SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY deste arquivo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave publicável (anon). Usada só no servidor (login e renovação de sessão); o navegador não a recebe.
SUPABASE_ANON_KEY=

# Opcional. Sem as duas, o botão de e-mail aparece desligado com a explicação.
# EMAIL_FROM precisa ser de um domínio verificado no Resend, ex.: "Eventos <credenciais@suaempresa.com.br>"
RESEND_API_KEY=
EMAIL_FROM=

# Usuário e senha que o navegador pede para abrir o sistema (HTTP Basic Auth).
# Transição: alternativa à sessão por login. Só saem da Vercel depois de `npm run primeiro-admin`
# rodar contra produção e o login funcionar (README, "Ligar o login em produção").
ADMIN_USER=
ADMIN_PASSWORD=
